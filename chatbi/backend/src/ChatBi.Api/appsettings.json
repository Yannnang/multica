{
  "ConnectionStrings": {
    "PlatformDb": ""
  },
  "Database": {
    "ApplyMigrationsOnStart": true
  },
  "Jwt": {
    "Issuer": "chatbi",
    "Audience": "chatbi-web",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7
  },
  "Feishu": {
    "UseMock": true,
    "AppId": "<FEISHU_APP_ID>",
    "RedirectUri": "<FEISHU_REDIRECT_URI_DEV>",
    "ScopeList": "<FEISHU_SCOPE_LIST>",
    "AuthorizeBaseUrl": "https://accounts.feishu.cn",
    "OpenApiBaseUrl": "https://open.feishu.cn",
    "AdminUnionId": "<ADMIN_UNION_ID>"
  },
  "AuthRedirect": {
    "DefaultRedirect": "/",
    "AllowedPrefixes": [ "/" ]
  },
  "Cors": {
    "Origins": []
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
